# Godot 4+ specific ignores
.godot/
/android/

# Generated by the GdUnit4 test adapter on each `dotnet test` run
gdunit4_testadapter_v5/*
# Hides the generated runner script from the editor; without it C# assembly reloads fail.
!gdunit4_testadapter_v5/.gdignore
TestResults/

# macOS Finder metadata
.DS_Store
