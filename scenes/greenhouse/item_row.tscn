[gd_scene format=3]

[node name="ItemRow" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Line" type="HSeparator" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PopoverSeparator"

[node name="Heading" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ToolLabel"

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
vertical_scroll_mode = 0

[node name="Items" type="HBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8
